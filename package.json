{
  "name": "naiwa-pet-repo",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tooling and verification gates for the dsh-naiwa-pet DSH plugin.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/check-package.mjs",
    "test": "node --test --test-isolation=none tests/manifest.test.mjs tests/assets.test.mjs tests/host-route.test.mjs tests/client-contract.test.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "static": "node scripts/check-static.mjs",
    "security": "node scripts/scan-secrets.mjs && node scripts/scan-dangerous.mjs",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
