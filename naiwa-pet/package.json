{
  "name": "dsh-naiwa-pet",
  "version": "0.2.0",
  "private": true,
  "description": "黄色奶娃桌宠：DSH 页面内浮窗 + 透明置顶桌面窗，可拖动、换装、点播动作表情。",
  "icon": "icon.png",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./content": "./content.js",
    "./core": "./pet-core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "pet-core.js",
    "content.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/*.png",
    "assets/*.json",
    "assets/outfits/**",
    "desktop/*",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
